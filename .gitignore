/_build/
/cover/
/deps/
/doc/
/tmp/
erl_crash.dump
*.ez
ccxt_extract-*.tar

# Qwen Code configuration (user-specific hooks and settings)
/.qwen/

# npm packages (installed via mix npm.install)
/node_modules/
/npm-cache/
package-lock.json
npm.lock
package.json

# CCXT source (cloned/symlinked during setup)
/priv/ccxt

# CCXT browser bundle (copied from node_modules during setup)
/priv/ccxt_bundle.js

# Derived extraction corpus — regenerated by `mix ccxt_extract.update`.
# Fresh clones run `mix setup` to materialize these locally; external
# consumers get them via `mix ccxt_extract.update --output DIR`.
# Contents-level patterns (`/*`) not directory-level (`/`), so the
# class_hierarchy.json negation below can re-include the one file
# `lib/ccxt_extract/tiers.ex` needs at compile time.
/priv/output/*
/priv/discoveries/*
!/priv/discoveries/class_hierarchy.json

# Generated caches
/.hex-docs/


# Claude Code plugin-managed worktrees (staged as submodule gitlinks otherwise)
/.claude/worktrees/
